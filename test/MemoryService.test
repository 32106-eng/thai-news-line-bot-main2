import { test } from "node:test";
import assert from "node:assert/strict";
import { createFakeFirestore } from "./helpers/fakeFirestore.js";
import { createMemoryService } from "../src/memory/memoryService.js";

function setup() {
  const { FieldValue, collection } = createFakeFirestore();
  const memories = collection("memories");
  const service = createMemoryService({ memories, FieldValue });
  return { service, memories };
}

test("getMemory: returns empty shape when nothing stored yet", async () => {
  const { service } = setup();
  const mem = await service.getMemory("person1");
  assert.deepEqual(mem, { name: null, facts: [] });
});

test("setName: stores and updates the name", async () => {
  const { service } = setup();
  await service.setName("person1", "กอล์ฟ");
  assert.equal((await service.getMemory("person1")).name, "กอล์ฟ");
  await service.setName("person1", "แนน");
  assert.equal((await service.getMemory("person1")).name, "แนน");
});

test("setName: ignores empty/non-string values", async () => {
  const { service } = setup();
  await service.setName("person1", "");
  await service.setName("person1", null);
  assert.equal((await service.getMemory("person1")).name, null);
});

test("addFact: appends facts with metadata (id, source, createdAt)", async () => {
  const { service } = setup();
  await service.addFact("person1", "ชอบดื่มกาแฟ", "auto");
  const mem = await service.getMemory("person1");
  assert.equal(mem.facts.length, 1);
  assert.equal(mem.facts[0].text, "ชอบดื่มกาแฟ");
  assert.equal(mem.facts[0].source, "auto");
  assert.ok(mem.facts[0].id);
  assert.ok(mem.facts[0].createdAt);
});

test("addFact: ignores empty text", async () => {
  const { service } = setup();
  await service.addFact("person1", "   ", "auto");
  assert.equal((await service.getMemory("person1")).facts.length, 0);
});

test("addFact: does not mix facts between different people", async () => {
  const { service } = setup();
  await service.addFact("person1", "fact for person1", "auto");
  await service.addFact("person2", "fact for person2", "auto");
  const mem1 = await service.getMemory("person1");
  const mem2 = await service.getMemory("person2");
  assert.equal(mem1.facts.length, 1);
  assert.equal(mem2.facts.length, 1);
  assert.equal(mem1.facts[0].text, "fact for person1");
  assert.equal(mem2.facts[0].text, "fact for person2");
});

test("addFact: caps at MAX_FACTS, dropping oldest first (FIFO)", async () => {
  const { service } = setup();
  for (let i = 0; i < service.MAX_FACTS + 5; i++) await service.addFact("person1", `fact ${i}`, "auto");
  const mem = await service.getMemory("person1");
  assert.equal(mem.facts.length, service.MAX_FACTS);
  // the oldest 5 facts (fact 0..4) should have been dropped
  assert.equal(mem.facts[0].text, "fact 5");
  assert.equal(mem.facts.at(-1).text, `fact ${service.MAX_FACTS + 4}`);
});

test("clearAll: wipes name and facts", async () => {
  const { service } = setup();
  await service.setName("person1", "กอล์ฟ");
  await service.addFact("person1", "ชอบกาแฟ", "auto");
  await service.clearAll("person1");
  assert.deepEqual(await service.getMemory("person1"), { name: null, facts: [] });
});

test("buildContextLine: empty string when nothing stored", () => {
  const { service } = setup();
  assert.equal(service.buildContextLine({ name: null, facts: [] }), "");
});

test("buildContextLine: includes name and facts when present", () => {
  const { service } = setup();
  const line = service.buildContextLine({ name: "กอล์ฟ", facts: [{ text: "ชอบดื่มกาแฟ" }, { text: "ทำงานเป็นวิศวกร" }] });
  assert.match(line, /ชื่อ: กอล์ฟ/);
  assert.match(line, /ชอบดื่มกาแฟ/);
  assert.match(line, /ทำงานเป็นวิศวกร/);
  assert.match(line, /ห้ามนำไปใช้กับคนอื่น/);
});

