# ป้านวล — ตัวอย่างไฟล์ .env
# คัดลอกไฟล์นี้เป็น ".env" แล้วใส่ค่าจริงของคุณ (ห้าม commit .env เข้า git)
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=
# ใช้อย่างใดอย่างหนึ่ง
OPENAI_API_KEY=
OPENROUTER_API_KEY=
# NVIDIA NIM: ใส่คีย์ NVIDIA ตรงนี้ (คีย์ที่ขึ้นต้น nvapi- ไม่ต้องใส่ใน OPENAI_API_KEY)
NVIDIA_API_KEY=
OPENAI_MODEL=openai/gpt-5-mini
# ── เลือกโมเดลให้ตอบเร็วขึ้นโดยความฉลาดไม่ลดมาก ─────────────────────────
# งานของบอทนี้ (จัดหมวดรายรับ-รายจ่าย, ตอบคำถามการเงินสั้น ๆ, อ่านสลิป) ไม่ต้องการโมเดลระดับ
# reasoning หนัก ๆ เลือกรุ่น "mini/flash" ของค่ายไหนก็ได้จะเร็วกว่ารุ่นใหญ่มาก โดยคุณภาพงานระดับนี้แทบไม่ต่าง:
#   OpenAI direct:  gpt-4.1-mini หรือ gpt-4o-mini (เร็วกว่า gpt-5-mini เพราะไม่มีขั้นตอน reasoning แฝง)
#   OpenRouter:     openai/gpt-4o-mini, google/gemini-2.5-flash
#   NVIDIA NIM:     ระบบจะล็อกเป็น nvidia/nemotron-mini-4b-instruct (NVIDIA 4B) อัตโนมัติ
#                    และจะไม่ใช้ OPENAI_MODEL เพื่อป้องกัน model เก่าหรือ model ID ผิดจนได้ 410
# ถ้าอยากได้ความฉลาดสูงสุดเท่าเดิมแต่แค่ให้ "คิดสั้นลง" ให้คงโมเดลเดิมไว้ แล้วปรับที่ max_tokens ในโค้ด
# (src/index.js, src/memory/extractMemory.js) แทน — ลดค่านั้นจะตัดเวลาที่โมเดลใช้ "ลากยาวเกินจำเป็น" โดยไม่ตัดคุณภาพ
# เพราะคำตอบจริงของบอทนี้สั้นอยู่แล้วตาม system prompt
# รหัสสำหรับลิงก์แดชบอร์ด: ตั้งเอง ห้ามแชร์
DASHBOARD_TOKEN=
# URL สาธารณะของเซิร์ฟเวอร์ (โดเมนจริงหรือ tunnel ที่เสถียร)
PUBLIC_BASE_URL=
PORT=3000
# ─── ระบบ Premium Subscription ───────────────────────────────────────────
# เลขบัญชี PromptPay ของร้าน/แอดมิน (เบอร์โทร 10 หลัก หรือเลขบัตร ปชช. 13 หลัก)
# ถ้าไม่ตั้งค่า ระบบจะไม่สามารถออก QR ให้ผู้ใช้จ่ายเงินได้ (จะแจ้งผู้ใช้ว่ายังไม่พร้อมใช้งาน)
PROMPTPAY_ID=
# คีย์ลับสำหรับเซ็น session cookie ของ Admin Dashboard (สุ่มค่ายาว ๆ เอง เช่น `openssl rand -hex 32`)
ADMIN_SESSION_SECRET=
# LINE Rich Menu ID สำหรับแพ็กเกจ Free / Premium (สร้างผ่าน LINE Developers Console หรือ Messaging API ก่อน)
LINE_RICH_MENU_FREE_ID=
LINE_RICH_MENU_PREMIUM_ID=
# LIFF ID สำหรับปุ่ม "สรุป"/"หมวด/งบ" บน Rich Menu ให้เปิดเว็บทันทีในคลิกเดียว (วิธีสร้าง: ดู README.md หัวข้อ "ตั้งค่า LIFF")
LIFF_ID=
# หมายเหตุ: ระบบนี้ยังไม่ได้เชื่อมกับ Payment Provider จริงที่ตรวจสอบธุรกรรมได้
# (ดู src/subscription/paymentProvider.js) ทุกสลิปที่ผ่าน OCR จะเข้าสถานะ PENDING_REVIEW
# เสมอ และต้องให้ Admin อนุมัติ/ปฏิเสธเองผ่าน /admin จนกว่าจะเชื่อม provider จริง
